# Neon Postgres 연결 문자열 (Neon 콘솔 → Connection string, "pooled connection" 권장)
DATABASE_URL=

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Google OAuth 클라이언트 (Google Cloud Console → API 및 서비스 → 사용자 인증 정보)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 관리자로 자동 지정될 이메일 (최초 1명, 이후엔 관리자 화면에서 다른 사람도 지정 가능)
ADMIN_EMAIL=yhmj102@gmail.com
